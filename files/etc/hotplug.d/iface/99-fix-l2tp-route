#!/bin/sh
# X1Pro L2TP 默认路由修复 - hotplug 脚本
# 安装: 放到 /etc/hotplug.d/iface/99-fix-l2tp-route
# 作用: 任意 L2TP 接口 UP 后 10 秒, 确保默认路由留在 WAN

[ "$ACTION" = "ifup" ] || exit 0

# 检测当前接口是否是 L2TP
PROTO=$(uci -q get network."$INTERFACE".proto 2>/dev/null)
[ "$PROTO" = "l2tp" ] || exit 0

L2TP_DEV="l2tp-$INTERFACE"

# 等 L2TP 完全稳定
sleep 10

# 删掉 L2TP 抢走的默认路由
ip route del default dev "$L2TP_DEV" 2>/dev/null

# 确保默认路由在 WAN
if ! ip route show default | grep -q "dev eth0"; then
  GW=$(ip route show default 2>/dev/null | sed -n 's/.*via \([^ ]*\) dev.*/\1/p' | head -1)
  [ -z "$GW" ] && GW=$(ifstatus wan 2>/dev/null | sed -n 's/.*"gateway": "\([^"]*\)".*/\1/p' | head -1)
  [ -z "$GW" ] && GW="192.168.3.1"
  ip route del default 2>/dev/null
  ip route add default via "$GW" dev eth0 2>/dev/null
  logger -t l2tp-fix "默认路由已修正: via $GW dev eth0"
fi

# 确保远端静态路由存在 (从 uci route section 读取)
for RT in $(uci -q show network | grep "=route" | cut -d= -f1); do
  RT_IF=$(uci -q get "$RT".interface 2>/dev/null)
  [ "$RT_IF" = "$INTERFACE" ] || continue
  TARGET=$(uci -q get "$RT".target 2>/dev/null)
  NETMASK=$(uci -q get "$RT".netmask 2>/dev/null)
  [ -z "$TARGET" ] && continue
  PREFIX=$(echo "$NETMASK" | awk -F. '{
    bits=0; for(i=1;i<=4;i++){ n=$i; while(n>0){bits+=n%2; n=int(n/2)} }
    print bits
  }' 2>/dev/null)
  ip route replace "$TARGET/$PREFIX" dev "$L2TP_DEV" 2>/dev/null
  logger -t l2tp-fix "VPN 路由已补: $TARGET/$PREFIX dev $L2TP_DEV"
done
