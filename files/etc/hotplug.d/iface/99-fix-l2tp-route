#!/bin/sh
# X1Pro VPN 自动检测+修复 — hotplug 脚本
# 任意网络接口变化(UP)后 15s, 调用 /root/vpn-check.sh 检测并修复
# 合并到固件: files/etc/hotplug.d/iface/99-fix-l2tp-route

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "loopback" ] && exit 0

CHECK_SCRIPT="/root/vpn-check.sh"

# 只在有 L2TP 接口且 vpn-check.sh 存在时执行
[ -f "$CHECK_SCRIPT" ] || exit 0
uci show network 2>/dev/null | grep -q "proto='l2tp'" || exit 0

# 后台延迟执行, 等网络完全稳定
(
  sleep 15
  sh "$CHECK_SCRIPT" 2>&1 | logger -t vpn-auto-fix
) &
