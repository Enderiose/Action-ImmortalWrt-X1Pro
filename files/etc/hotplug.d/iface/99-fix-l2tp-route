#!/bin/sh
# X1Pro VPN auto-check + auto-fix — hotplug script
# Triggered on ANY network interface UP event; runs /root/vpn-check.sh 15s later
# Built into firmware via: files/etc/hotplug.d/iface/99-fix-l2tp-route

# Only act on "ifup" events (ignore ifdown / ifchange)
[ "$ACTION" = "ifup" ] || exit 0

# Skip loopback interface
[ "$INTERFACE" = "loopback" ] && exit 0

CHECK_SCRIPT="/root/vpn-check.sh"

# Only proceed if vpn-check.sh exists AND an L2TP interface is configured
[ -f "$CHECK_SCRIPT" ] || exit 0
uci show network 2>/dev/null | grep -q "proto='l2tp'" || exit 0

# Run in background with a delay so the network is fully stable before checking
(
  sleep 15
  sh "$CHECK_SCRIPT" 2>&1 | logger -t vpn-auto-fix
) &
